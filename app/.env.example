# Copy to .env.local for local development (`pnpm stack:start` prints these values).
# Never commit real keys. Hosted projects get their values from Vercel's environment settings.

# Supabase project URL and PUBLISHABLE key (safe for the browser).
# The SECRET key must never be used in client code or committed.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# SERVER ONLY. The Supabase secret key lets the server send quotes (the database refuses
# those requests from anyone else). `pnpm env:local` writes the local stack's key. On hosted
# projects it lives only in Vercel's environment settings: never in code, chat or GitHub.
SUPABASE_SECRET_KEY=

# Show the "Continue with Google" button. Only set to true once Google sign-in is configured.
NEXT_PUBLIC_GOOGLE_SIGNIN=false

# Local only: mailbox that end-to-end tests read magic-link emails from.
LOCAL_MAILPIT_URL=http://127.0.0.1:54324
