{
  "name": "app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "db:start": "supabase start -x studio,imgproxy,mailpit,edge-runtime,logflare,vector,realtime,postgres-meta,postgrest,supavisor",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "bash supabase/tests/run-local-stack.sh",
    "db:test:plain": "bash supabase/tests/run-plain-postgres.sh",
    "stack:start": "supabase start -x studio,imgproxy,edge-runtime,logflare,vector,realtime,postgres-meta,supavisor",
    "stack:stop": "supabase stop",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "perf": "bash scripts/perf/run-perf.sh",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "env:local": "bash scripts/write-env-local.sh",
    "local": "pnpm stack:start && pnpm env:local && next dev"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@react-pdf/renderer": "^4.9.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.49.0",
    "next": "16.3.7",
    "pdfjs-dist": "^6.4.299",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.1",
    "sharp": "0.35.5",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.7",
    "supabase": "^2.118.0",
    "tailwindcss": "^4",
    "typescript": "^6",
    "vitest": "^5.0.2"
  },
  "packageManager": "pnpm@10.33.0"
}
